# ── Trading 212 ─────────────────────────────────────────────
# Get your API key from Trading 212 → Settings → API (beta)
# Use PRACTICE key first to test!
TRADING212_API_KEY=
TRADING212_ENV=practice

# ── OpenAI ──────────────────────────────────────────────────
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ── NewsAPI ─────────────────────────────────────────────────
# Free tier: https://newsapi.org/register
NEWSAPI_KEY=

# ── Telegram Notifications ──────────────────────────────────
# 1. Message @BotFather on Telegram → /newbot → copy token
# 2. Message your bot, then visit:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
#    to find your chat_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Bot Settings ────────────────────────────────────────────
DRY_RUN=true
ORDER_SIZE_EUR=100
TAKE_PROFIT_PCT=8.0
STOP_LOSS_PCT=2.0
PARTIAL_TP_PCT=3.0
MIN_CONFIDENCE=70
MAX_POSITIONS=10
MAX_SECTOR_PCT=20.0
EARNINGS_BLACKOUT_DAYS=3
SCAN_HOUR=9
SCAN_MINUTE=0
TIMEZONE=Europe/Berlin
REBALANCE_DAY=friday

# ── Aggressive Strategy (v3) ───────────────────────────────
AGG_ENABLED=true
AGG_STOP_LOSS_PCT=5.0
AGG_TP_TIER1=15.0
AGG_TP_TIER2=30.0
AGG_TP_TIER3=50.0
AGG_MAX_POSITIONS=5
MIN_CATALYST_SCORE=7
MOMENTUM_MIN_GAIN_PCT=5.0
MOMENTUM_VOL_MULTIPLIER=3.0
AGG_SIZE_MODERATE_PCT=5.0
AGG_SIZE_HIGH_PCT=15.0
AGG_SIZE_MAX_PCT=25.0

# ── Multi-Source Intelligence (v4) ────────────────────────────────────────────
ENABLE_REDDIT=true
ENABLE_OPTIONS_FLOW=true
ENABLE_INSIDER=true
ENABLE_TRENDS=false
